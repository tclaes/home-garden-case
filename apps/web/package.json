{
  "name": "@itp-home-garden/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "scope:web",
      "type:app"
    ],
    "targets": {
      "dev": {
        "options": {
          "command": "next dev -p 4200 --webpack"
        }
      },
      "start": {
        "options": {
          "command": "next start -p 4200"
        }
      },
      "build": {
        "dependsOn": ["^build", "^typecheck"],
        "options": {
          "command": "next build --webpack"
        }
      }
    }
  },
  "dependencies": {
    "next": "~16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@itp-home-garden/shared-api-contracts": "*",
    "@itp-home-garden/web-api-client": "*",
    "@itp-home-garden/web-data-access-gardens": "*",
    "@itp-home-garden/web-data-access-plants": "*",
    "@itp-home-garden/web-feature-gardens": "*",
    "@itp-home-garden/web-feature-plants": "*",
    "@itp-home-garden/web-ui": "*"
  }
}
